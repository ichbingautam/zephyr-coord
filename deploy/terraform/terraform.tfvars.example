# Development environment example
environment        = "dev"
region             = "us-east-1"
cluster_name       = "zephyr-coord"
cluster_size       = 3
instance_type      = "t3.medium"
vpc_cidr           = "10.0.0.0/16"
kubernetes_version = "1.29"
zephyr_image       = "ghcr.io/ichbingautam/zephyr-coord:latest"
storage_size       = 20
